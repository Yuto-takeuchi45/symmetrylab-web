# Public tag IDs are intentionally blank/placeholders for local and preview use.
# Set real values only in the deployment environment after GTM/GA4/Google Ads setup.
SYMMETRY_GTM_CONTAINER_ID=GTM-XXXXXXX
SYMMETRY_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
SYMMETRY_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXXX
SYMMETRY_GOOGLE_ADS_CONVERSION_LABEL=XXXXXXXXXXXX
PRIVACY_POLICY_VERSION=current
# Required for admin APIs. Set a strong secret in the deployment environment.
ADMIN_KEY=change-this-in-the-deployment-environment
